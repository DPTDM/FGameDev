dialogue_texts = Array[String](["Are you lost, Hunter? The temple ruins are awfully cold tonight.", "You smell different from the villagers... less afraid. How curious.", "But flesh is flesh. And I am so very hungry.", "Run, little rabbit. Let's see how fast you are!"])

