[node name="KuyaVendor" parent="NPCs" unique_id=1944876763 instance=ExtResource("2_w4ffd")]
position = Vector2(760, 571)
scale = Vector2(0.125, 0.125)
npc_name = "Kuya Vendor"
dialogue_texts = Array[String](["Boss! Kain muna! You can't hunt monsters on an empty stomach.", "I saw the Guild vehicles heading out earlier. Stay safe out there, okay?"])

[node name="CollisionShape2D" parent="NPCs/KuyaVendor" index="1" unique_id=1625871359]
position = Vector2(0.5, -2.5)
shape = SubResource("RectangleShape2D_w61ov")

[node name="Student" parent="NPCs" unique_id=1812816067 instance=ExtResource("2_w4ffd")]
position = Vector2(337, 814)
scale = Vector2(0.125, 0.125)
npc_name = "Student"
dialogue_texts = Array[String](["The Guild operates with impunity while the common folk suffer the consequences of these mythic rifts.", "If they don't fix the borders soon, it's going to become a social cancer we can't cure."])

[node name="CollisionShape2D" parent="NPCs/Student" index="1" unique_id=1625871359]
position = Vector2(0.5, -2.5)
shape = SubResource("RectangleShape2D_w61ov")

[node name="Nurse" parent="NPCs" unique_id=1300997016 instance=ExtResource("2_w4ffd")]
position = Vector2(230, 779)
scale = Vector2(0.125, 0.125)
monitoring = false
npc_name = "Nurse"
dialogue_texts = Array[String](["I haven't slept in two days. We just had another Guild squad wheeled into the emergency room.", "Whatever is out there in the scouting forest, it's tearing through standard armor like paper. Be careful."])

[node name="CollisionShape2D" parent="NPCs/Nurse" index="1" unique_id=1625871359]
position = Vector2(0.5, -2.5)
shape = SubResource("RectangleShape2D_w61ov")

[node name="Conspiracist" parent="NPCs" unique_id=1686882236 instance=ExtResource("2_w4ffd")]
position = Vector2(596, 246)
scale = Vector2(0.125, 0.125)
npc_name = "Conspiracist"
dialogue_texts = Array[String](["You actually believe the Guild's reports? Sus! They are hiding something.", "I saw a Guild transport truck last night. It was heavily armored, and I swear I heard something inside it scratching at the metal."])

[node name="CollisionShape2D" parent="NPCs/Conspiracist" index="1" unique_id=1625871359]
position = Vector2(0.5, -2.5)
shape = SubResource("RectangleShape2D_w61ov")

[node name="GuildFanGirl" parent="NPCs" unique_id=964791258 instance=ExtResource("2_w4ffd")]
position = Vector2(332, 494)
scale = Vector2(0.125, 0.125)
npc_name = "Guild Fan"
dialogue_texts = Array[String](["Whoa, is that a real Anti-Mythics Guild uniform? You guys are like actual superheroes!", "When I graduate, I'm going to register as a Mage specialization and clear out the rifts too!"])

[node name="CollisionShape2D" parent="NPCs/GuildFanGirl" index="1" unique_id=1625871359]
position = Vector2(0.5, -2.5)
shape = SubResource("RectangleShape2D_w61ov")

