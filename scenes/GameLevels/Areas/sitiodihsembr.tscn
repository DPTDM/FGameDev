position = Vector2(724, 340)
scale = Vector2(0.125, 0.125)
npc_name = "Barangay Tanod 1"
dialogue_texts = Array[String](["Hello traveler, are you the one who will investigate the murders here?", "Come in, our kapitan  has been waiting for your arrival."])

[node name="CollisionShape2D" parent="NPCs/Tanod" index="1" unique_id=1625871359]
