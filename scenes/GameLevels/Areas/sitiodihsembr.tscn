[node name="Tanod2" parent="NPCs" unique_id=1624838490 instance=ExtResource("3_4bosr")]
position = Vector2(724, 654)
scale = Vector2(0.125, 0.125)
npc_name = "Barangay Tanod 2"
dialogue_texts = Array[String](["I'm supposed to patrol the perimeter, but I refuse to go near the tree line.", "Last night, the stray dogs wouldn't stop barking. But they weren't barking at the bushes... they were barking up at the canopy."])

[node name="CollisionShape2D" parent="NPCs/Tanod2" index="1" unique_id=1625871359]
position = Vector2(0.5, -6.5)
shape = SubResource("RectangleShape2D_y10yc")

[node name="Kapitan" parent="NPCs" unique_id=1517528943 instance=ExtResource("3_4bosr")]
position = Vector2(742, 477)
scale = Vector2(0.125, 0.125)
npc_name = "Kapitan"
dialogue_texts = Array[String](["You are the Hunter they sent? You look far too young to face what is in those woods.", "Do not stray from the path. The shadows here have teeth."])

[node name="CollisionShape2D" parent="NPCs/Kapitan" index="1" unique_id=1625871359]
position = Vector2(0.5, -6.5)
