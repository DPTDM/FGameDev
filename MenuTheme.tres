; MenuTheme.tres — Godot 4 Theme resource (text format)
; Sets Jersey15-Regular as the default font for every Label, Button,
; LineEdit, and other Control node in the project.
;
; To apply globally:
;   Project Settings → GUI → Theme → Custom → load this file.
; Or per-scene: select the root Control → Inspector → Theme → load this file.

[gd_resource type="Theme" format=3]

[ext_resource type="FontFile" path="res://fonts/Jersey15.tres" id="1"]

[resource]
; ── Default font for ALL controls ────────────────────────────────────────────
default_font = ExtResource("1")
default_font_size = 18

; ── Button styles ─────────────────────────────────────────────────────────────
Button/fonts/font = ExtResource("1")
Button/font_sizes/font_size = 20
Button/colors/font_color         = Color(0.95, 0.93, 0.88, 1)
Button/colors/font_hover_color   = Color(1.0,  1.0,  1.0,  1)
Button/colors/font_pressed_color = Color(0.9,  0.85, 0.3,  1)
Button/colors/font_disabled_color = Color(0.4, 0.4,  0.45, 1)
Button/styles/normal   = SubResource("StyleBoxFlat_normal")
Button/styles/hover    = SubResource("StyleBoxFlat_hover")
Button/styles/pressed  = SubResource("StyleBoxFlat_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_disabled")

; ── Label ─────────────────────────────────────────────────────────────────────
Label/fonts/font = ExtResource("1")
Label/font_sizes/font_size = 16

; ── LineEdit ──────────────────────────────────────────────────────────────────
LineEdit/fonts/font = ExtResource("1")
LineEdit/font_sizes/font_size = 16

; ── OptionButton ──────────────────────────────────────────────────────────────
OptionButton/fonts/font = ExtResource("1")
OptionButton/font_sizes/font_size = 16

; ── CheckBox ──────────────────────────────────────────────────────────────────
CheckBox/fonts/font = ExtResource("1")
CheckBox/font_sizes/font_size = 16

; ── TabContainer ──────────────────────────────────────────────────────────────
TabContainer/fonts/font = ExtResource("1")
TabContainer/font_sizes/font_size = 16

; ── PopupMenu ─────────────────────────────────────────────────────────────────
PopupMenu/fonts/font = ExtResource("1")
PopupMenu/font_sizes/font_size = 16

; ── TooltipLabel ──────────────────────────────────────────────────────────────
TooltipLabel/fonts/font = ExtResource("1")
TooltipLabel/font_sizes/font_size = 14

; ── StyleBoxes ───────────────────────────────────────────────────────────────

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_normal"]
bg_color = Color(0.16, 0.17, 0.22, 1)
border_width_left   = 2
border_width_top    = 2
border_width_right  = 2
border_width_bottom = 2
border_color = Color(0.35, 0.37, 0.48, 1)
corner_radius_top_left     = 6
corner_radius_top_right    = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left  = 6
content_margin_left   = 16
content_margin_right  = 16
content_margin_top    = 10
content_margin_bottom = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hover"]
bg_color = Color(0.22, 0.24, 0.32, 1)
border_width_left   = 2
border_width_top    = 2
border_width_right  = 2
border_width_bottom = 2
border_color = Color(0.9, 0.85, 0.3, 1)
corner_radius_top_left     = 6
corner_radius_top_right    = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left  = 6
content_margin_left   = 16
content_margin_right  = 16
content_margin_top    = 10
content_margin_bottom = 10

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pressed"]
bg_color = Color(0.28, 0.26, 0.12, 1)
border_width_left   = 2
